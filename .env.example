# ── Copy this to .env and fill it in. NEVER commit .env. ───────────────────

# ── Interactive Brokers ──
# TWS or IB Gateway must be running and logged in. There is no fallback feed.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# TWS reports whatever timezone it was logged in with, and some of its names
# are not IANA ones. Map them here.
IBAPI_TIMEZONE_ALIASES=Gulf Standard Time=Asia/Dubai

# ── Telegram ──
# The token MUST be quoted if it contains a colon, or the shell eats it.
TELEGRAM_BOT_TOKEN="000000000:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TELEGRAM_CHAT_ID=000000000

# ── The record ──
#
# Either Postgres.app on the Mac (port 5432) or the container in
# docker-compose.yml (port 5434). The url is the only thing that decides.
#
# THE PASSWORD IS PERCENT-ENCODED, and that is not optional. An @ : / or # in
# a password is the separator the url parser is looking for, so it reads the
# wrong thing rather than failing -- @ becomes %40. Simplest way out is a
# password without those characters.
#
# THE BOT DOES NOT CONNECT AS A SUPERUSER. `nsc` owns nsc_trades and nothing
# else, so a bad query in this project cannot reach another database:
#
#     CREATE ROLE nsc LOGIN PASSWORD 'pick-one';
#     ALTER DATABASE nsc_trades OWNER TO nsc;
#     ALTER SCHEMA public OWNER TO nsc;      -- and the tables, or it can
#     ALTER TABLE candles OWNER TO nsc;      -- connect and not write
#     ALTER TABLE _sqlx_migrations OWNER TO nsc;
# The container reads this one. RAW -- it is a value, not a url.
POSTGRES_PASSWORD=pick-one

# The bot reads this one. THE PASSWORD IS PERCENT-ENCODED HERE and raw above:
# an @ : / or # is the separator a url parser looks for, so it reads the wrong
# thing rather than failing. @ becomes %40. Simplest way out is a password
# without those characters.
#
# Port 5434 is the container in docker-compose.yml. 5432 would be a Postgres
# installed on the Mac itself.
DATABASE_URL=postgres://nsc:pick-one@localhost:5434/nsc_trades
