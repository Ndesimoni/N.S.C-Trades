# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# ── Storage ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://nsc:nsc@localhost:5432/nsc_trades
REDIS_URL=redis://localhost:6379

# ── Market data (fill in whichever source you picked) ──────────────────────
# The broker is hidden behind the MarketDataSource trait in nsc-data, so
# swapping providers touches exactly one crate.
MARKET_DATA_PROVIDER=oanda          # oanda | mt5_bridge | twelvedata | csv
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice                  # practice | live  (live = data only in v1)

# ── Telegram ───────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=                   # where signals get delivered
TELEGRAM_WEBHOOK_URL=               # https:// — Telegram refuses plain http

# ── News & economic calendar ───────────────────────────────────────────────
FINNHUB_API_KEY=
ECONOMIC_CALENDAR_PROVIDER=finnhub

# ── AI validation layer ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
AI_VALIDATION_ENABLED=false         # keep false until Phase 5

# ── Runtime ────────────────────────────────────────────────────────────────
RUST_LOG=info,nsc_ta=debug,nsc_strategy=debug
TZ=UTC                              # the server clock must be UTC. See config/app.toml.
